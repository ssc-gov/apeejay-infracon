# Server-side only (Vercel Project Settings > Environment Variables). Never prefix with VITE_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are delivered
ENQUIRY_TO_EMAIL=apeejayinfra@gmail.com
# Must be a sender on a domain verified in Resend (e.g. enquiries@apeejayinfracon.com)
ENQUIRY_FROM_EMAIL=Apeejay Website <enquiries@apeejayinfracon.com>
# Optional: restricts API to your own origin
SITE_URL=https://apeejayinfracon.com
